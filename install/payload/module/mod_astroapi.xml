<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
    <name>mod_astroapi</name>
    <author>Rainer Minixhofer</author>
    <creationDate>2026-11-19</creationDate>
    <copyright>(C) 2026</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>info@astroapi.local</authorEmail>
    <version>1.0.0</version>
    <description>MOD_ASTROAPI_DESC</description>
    <namespace>Joomla\Module\AstroApi</namespace>
    
    <files>
        <filename module="mod_astroapi">mod_astroapi.php</filename>
        <filename>helper.php</filename>
        <folder>tmpl</folder>
        <folder>media</folder>
        <folder>language</folder>
        <folder>backend</folder>
        <folder>extensions</folder>
    </files>

    <languages>
        <language tag="de">language/de-DE/mod_astroapi.ini</language>
        <language tag="de">language/de-DE/mod_astroapi.sys.ini</language>
        <language tag="en">language/en-GB/mod_astroapi.ini</language>
        <language tag="en">language/en-GB/mod_astroapi.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic" label="MOD_ASTROAPI_FIELDSET_BASIC">
                <field
                    name="astroapi_url"
                    type="url"
                    label="MOD_ASTROAPI_FIELD_URL_LABEL"
                    description="MOD_ASTROAPI_FIELD_URL_DESC"
                    default="http://localhost:8010"
                    required="true"
                />
                <field
                    name="display_mode"
                    type="list"
                    label="MOD_ASTROAPI_FIELD_MODE_LABEL"
                    description="MOD_ASTROAPI_FIELD_MODE_DESC"
                    default="list">
                    <option value="list">MOD_ASTROAPI_MODE_LIST</option>
                    <option value="gallery">MOD_ASTROAPI_MODE_GALLERY</option>
                    <option value="map">MOD_ASTROAPI_MODE_MAP</option>
                </field>
                <field
                    name="items_per_page"
                    type="integer"
                    label="MOD_ASTROAPI_FIELD_ITEMS_LABEL"
                    description="MOD_ASTROAPI_FIELD_ITEMS_DESC"
                    default="10"
                    min="1"
                    max="100"
                />
                <field
                    name="cache_time"
                    type="integer"
                    label="MOD_ASTROAPI_FIELD_CACHE_LABEL"
                    description="MOD_ASTROAPI_FIELD_CACHE_DESC"
                    default="3600"
                    min="0"
                />
            </fieldset>
            <fieldset name="advanced" label="JADVANCED">
                <field
                    name="layout"
                    type="modulelayout"
                    label="JFIELD_ALT_LAYOUT_LABEL"
                    description="JFIELD_ALT_MODULE_LAYOUT_DESC"
                />
                <field
                    name="moduleclass_sfx"
                    type="textarea"
                    label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
                    description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC"
                    rows="3"
                />
                <field
                    name="cache"
                    type="list"
                    label="COM_MODULES_FIELD_CACHING_LABEL"
                    description="COM_MODULES_FIELD_CACHING_DESC"
                    default="1">
                    <option value="1">JGLOBAL_USE_GLOBAL</option>
                    <option value="0">COM_MODULES_FIELD_VALUE_NOCACHE</option>
                </field>
                <field
                    name="cache_time"
                    type="integer"
                    label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
                    description="COM_MODULES_FIELD_CACHE_TIME_DESC"
                    default="15"
                />
            </fieldset>
        </fields>
    </config>
</extension>
